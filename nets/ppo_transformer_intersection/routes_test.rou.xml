    <flow id="flow_south_deliverys_mid1" type="delivery" begin="600" end="1200" vehsPerHour="80" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_buses_mid1" type="bus" begin="600" end="1200" vehsPerHour="240" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_cars_mid1" type="car" begin="600" end="1200" vehsPerHour="1200" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_west_deliverys_mid1" type="delivery" begin="600" end="1200" vehsPerHour="40" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_buses_mid1" type="bus" begin="600" end="1200" vehsPerHour="140" route="rd_west" departLane="best" departSpeed="max"/>
