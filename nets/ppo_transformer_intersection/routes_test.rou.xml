    <flow id="flow_west_deliverys_mid2" type="delivery" begin="2400" end="3000" vehsPerHour="40" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_buses_mid2" type="bus" begin="2400" end="3000" vehsPerHour="140" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_cars_mid2" type="car" begin="2400" end="3000" vehsPerHour="720" route="rd_west" departLane="best" departSpeed="max"/>

    <!-- begin="3000" flows (sorted by begin, end, id) -->
    <flow id="flow_east_deliverys_low2" type="delivery" begin="3000" end="7200" vehsPerHour="20" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_east_buses_low2" type="bus" begin="3000" end="7200" vehsPerHour="70" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_east_cars_low2" type="car" begin="3000" end="7200" vehsPerHour="360" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_north_deliverys_low2" type="delivery" begin="3000" end="7200" vehsPerHour="40" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_buses_low2" type="bus" begin="3000" end="7200" vehsPerHour="120" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_cars_low2" type="car" begin="3000" end="7200" vehsPerHour="600" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_south_deliverys_low2" type="delivery" begin="3000" end="7200" vehsPerHour="40" route="rd_south" departLane="best" departSpeed="max"/>
