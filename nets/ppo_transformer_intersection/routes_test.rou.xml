    <flow id="flow_south_deliverys_peak1" type="delivery" begin="1200" end="1800" vehsPerHour="120" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_buses_peak1" type="bus" begin="1200" end="1800" vehsPerHour="360" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_cars_peak1" type="car" begin="1200" end="1800" vehsPerHour="1800" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_west_deliverys_peak1" type="delivery" begin="1200" end="1800" vehsPerHour="60" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_buses_peak1" type="bus" begin="1200" end="1800" vehsPerHour="210" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_cars_peak1" type="car" begin="1200" end="1800" vehsPerHour="1080" route="rd_west" departLane="best" departSpeed="max"/>

    <!-- begin="1800" flows (sorted by begin, end, id) -->
