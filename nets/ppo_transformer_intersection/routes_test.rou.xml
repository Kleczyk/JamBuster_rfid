<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle types -->
    <vType id="car" vClass="passenger" accel="2.6" decel="4.5" sigma="0.6" length="5.0" minGap="2.5" maxSpeed="50.0" guiShape="passenger" color="1,1,0"/>
    <vType id="bus" vClass="bus" accel="1.2" decel="4.0" sigma="0.6" length="12.0" minGap="3.0" maxSpeed="30.0" guiShape="bus" color="0,0,1" personCapacity="85"/>
    <vType id="delivery" vClass="delivery" accel="1.5" decel="4.0" sigma="0.5" length="7.5" minGap="2.5" maxSpeed="36.0" speedFactor="1.0" guiShape="delivery" color="0.8,0.4,0"/>

    <!-- Route distributions per approach (test: more straight N/S, more turns E/W) -->
    <routeDistribution id="rd_north">
        <route id="rd_north_straight" edges="north_to_center center_to_south" probability="0.6"/>
        <route id="rd_north_right" edges="north_to_center center_to_east" probability="0.2"/>
        <route id="rd_north_left" edges="north_to_center center_to_west" probability="0.2"/>
    </routeDistribution>

    <routeDistribution id="rd_south">
        <route id="rd_south_straight" edges="south_to_center center_to_north" probability="0.6"/>
        <route id="rd_south_right" edges="south_to_center center_to_east" probability="0.2"/>
        <route id="rd_south_left" edges="south_to_center center_to_west" probability="0.2"/>
    </routeDistribution>

    <routeDistribution id="rd_east">
        <route id="rd_east_straight" edges="east_to_center center_to_west" probability="0.35"/>
        <route id="rd_east_right" edges="east_to_center center_to_north" probability="0.30"/>
        <route id="rd_east_left" edges="east_to_center center_to_south" probability="0.35"/>
    </routeDistribution>

    <routeDistribution id="rd_west">
        <route id="rd_west_straight" edges="west_to_center center_to_east" probability="0.35"/>
        <route id="rd_west_right" edges="west_to_center center_to_north" probability="0.30"/>
        <route id="rd_west_left" edges="west_to_center center_to_south" probability="0.35"/>
    </routeDistribution>

    <!-- Traffic flows (per hour) with directional imbalance: N/S heavier than E/W -->
    <!-- Low:  N/S cars=600, buses=120, amb=40 (total 760/h) -->
    <!-- Mid:  N/S cars=1200, buses=240, amb=80 (total 1520/h) -->
    <!-- Peak: N/S cars=1800, buses=360, amb=120 (total 2280/h) -->
    <!-- Low:  E/W cars=360, buses=70, amb=20 (total 450/h) -->
    <!-- Mid:  E/W cars=720, buses=140, amb=40 (total 900/h) -->
    <!-- Peak: E/W cars=1080, buses=210, amb=60 (total 1350/h) -->

    <!-- begin="0" flows (sorted by begin, end, id) -->
    <flow id="flow_east_deliverys_low1" type="delivery" begin="0" end="600" vehsPerHour="20" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_east_buses_low1" type="bus" begin="0" end="600" vehsPerHour="70" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_east_cars_low1" type="car" begin="0" end="600" vehsPerHour="360" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_north_deliverys_low1" type="delivery" begin="0" end="600" vehsPerHour="40" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_buses_low1" type="bus" begin="0" end="600" vehsPerHour="120" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_cars_low1" type="car" begin="0" end="600" vehsPerHour="600" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_south_deliverys_low1" type="delivery" begin="0" end="600" vehsPerHour="40" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_buses_low1" type="bus" begin="0" end="600" vehsPerHour="120" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_cars_low1" type="car" begin="0" end="600" vehsPerHour="600" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_west_deliverys_low1" type="delivery" begin="0" end="600" vehsPerHour="20" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_buses_low1" type="bus" begin="0" end="600" vehsPerHour="70" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_cars_low1" type="car" begin="0" end="600" vehsPerHour="360" route="rd_west" departLane="best" departSpeed="max"/>

    <!-- begin="600" flows (sorted by begin, end, id) -->
