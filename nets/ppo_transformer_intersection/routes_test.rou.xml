    <flow id="flow_east_buses_mid2" type="bus" begin="2400" end="3000" vehsPerHour="140" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_east_cars_mid2" type="car" begin="2400" end="3000" vehsPerHour="720" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_north_deliverys_mid2" type="delivery" begin="2400" end="3000" vehsPerHour="80" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_buses_mid2" type="bus" begin="2400" end="3000" vehsPerHour="240" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_cars_mid2" type="car" begin="2400" end="3000" vehsPerHour="1200" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_south_deliverys_mid2" type="delivery" begin="2400" end="3000" vehsPerHour="80" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_buses_mid2" type="bus" begin="2400" end="3000" vehsPerHour="240" route="rd_south" departLane="best" departSpeed="max"/>
