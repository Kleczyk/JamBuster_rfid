    <flow id="flow_east_buses_peak2" type="bus" begin="1800" end="2400" vehsPerHour="210" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_east_cars_peak2" type="car" begin="1800" end="2400" vehsPerHour="1080" route="rd_east" departLane="best" departSpeed="max"/>
    <flow id="flow_north_deliverys_peak2" type="delivery" begin="1800" end="2400" vehsPerHour="120" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_buses_peak2" type="bus" begin="1800" end="2400" vehsPerHour="360" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_north_cars_peak2" type="car" begin="1800" end="2400" vehsPerHour="1800" route="rd_north" departLane="best" departSpeed="max"/>
    <flow id="flow_south_deliverys_peak2" type="delivery" begin="1800" end="2400" vehsPerHour="120" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_buses_peak2" type="bus" begin="1800" end="2400" vehsPerHour="360" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_south_cars_peak2" type="car" begin="1800" end="2400" vehsPerHour="1800" route="rd_south" departLane="best" departSpeed="max"/>
    <flow id="flow_west_deliverys_peak2" type="delivery" begin="1800" end="2400" vehsPerHour="60" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_buses_peak2" type="bus" begin="1800" end="2400" vehsPerHour="210" route="rd_west" departLane="best" departSpeed="max"/>
    <flow id="flow_west_cars_peak2" type="car" begin="1800" end="2400" vehsPerHour="1080" route="rd_west" departLane="best" departSpeed="max"/>

    <!-- begin="2400" flows (sorted by begin, end, id) -->
